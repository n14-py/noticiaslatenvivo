# La misma clave que usa lfaftechapi en x-api-key
ADMIN_API_KEY=cambia-esta-clave
MAIN_API_URL=https://lfaftechapi.onrender.com
PORT=3002
CANAL_NOMBRE=Noticias LAT
LIVE_PRIVACY=public

# Gemini escribe título, descripción, intro y puentes.
# Si no hay clave, el directo igual sale con plantillas distintas cada vez.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.0-flash

# Pauta del vivo. El canal tiene que estar en el Programa de Partners.
AD_CUEPOINT_SECONDS=30
AD_MIN_GAP_SECONDS=120
AD_REPEAT_SECONDS=600
# token_0.json … token_3.json son los canales de lfaftechapi:
# 0 Noticias Lat, 1 Última Hora, 2 Ahora, 3 Hoy.
YOUTUBE_MAX_ACCOUNTS=6

# Opcional. Misma cuenta R2 que TTS-FMPEG.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
